{
  "name": "reorder-demo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "ng test --watch=false --coverage",
    "test:scripts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test --experimental-test-coverage --test-coverage-include=scripts/hosting-site.mjs --test-coverage-include=scripts/noaa-weekly.mjs --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 \"scripts/*.test.mjs\"",
    "data:noaa": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/noaa-to-json.mjs",
    "e2e": "playwright test",
    "release:hosting": "node scripts/release-hosting.mjs",
    "verify:build": "pnpm run build:hosting && node scripts/verify-build.mjs",
    "build:hosting": "ng build && node scripts/postbuild.mjs",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.12.0",
    "@vitest/coverage-v8": "5.0.5",
    "angular-eslint": "22.6.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.31",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
